index e0b912a..58d64d4 100644
--- a/cloudflare-env.d.ts
+++ b/cloudflare-env.d.ts
@@ -1,6 +1,7 @@
 declare namespace Cloudflare {
   interface Env {
     DB?: D1Database;
+    LOGO_VISION_API_KEY?: string;
     ADMIN_USER_IDS?: string;
     LEAD_COLLECTION_ENABLED?: string;
     ANALYTICS_ENABLED?: string;
diff --git a/server/logo-source-search.mjs b/server/logo-source-search.mjs
new file mode 100644
index 0000000..be88001
--- /dev/null
+++ b/server/logo-source-search.mjs
@@ -0,0 +1,78 @@
+const MAX_IMAGE_BYTES = 1024 * 1024;
+const endpoint = 'https://vision.googleapis.com/v1/images:annotate';
+
+function result(payload, status = 200) {
+  return Response.json(payload, { status, headers: { 'cache-control': 'private, no-store' } });
+}
+
+function publicHttps(value) {
+  try {
+    const url = new URL(value);
+    return url.protocol === 'https:' && !url.username && !url.password ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+async function readImage(request) {
+  const reader = request.body?.getReader();
+  if (!reader) return null;
+  const chunks = [];
+  let length = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    length += value.length;
+    if (length > MAX_IMAGE_BYTES) {
+      await reader.cancel();
+      return null;
+    }
+    chunks.push(value);
+  }
+  return Buffer.concat(chunks, length);
+}
+
+export async function searchLogoSources(request, apiKey, fetcher = fetch) {
+  if (request.headers.get('origin') !== new URL(request.url).origin ||
+      ![null, 'same-origin'].includes(request.headers.get('sec-fetch-site'))) {
+    return result({ status: 'origin_not_allowed' }, 403);
+  }
+  if (!apiKey) return result({ status: 'search_unconfigured' }, 503);
+  if (!['image/jpeg', 'image/png'].includes(request.headers.get('content-type'))) {
+    return result({ status: 'unsupported_image' }, 415);
+  }
+  try {
+    const image = await readImage(request);
+    if (!image?.length) return result({ status: 'invalid_image_size' }, 400);
+    const png = image.subarray(0, 8).toString('hex') === '89504e470d0a1a0a';
+    const jpeg = image.subarray(0, 3).toString('hex') === 'ffd8ff';
+    if (request.headers.get('content-type') === 'image/png' ? !png : !jpeg) {
+      return result({ status: 'invalid_image' }, 400);
+    }
+    const response = await fetcher(endpoint, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', 'x-goog-api-key': apiKey },
+      signal: AbortSignal.timeout(8000),
+      body: JSON.stringify({ requests: [{
+        image: { content: image.toString('base64') },
+        features: [{ type: 'WEB_DETECTION', maxResults: 10 }]
+      }] })
+    });
+    if (!response.ok) return result({ status: 'search_unavailable' }, 502);
+    const { responses } = await response.json();
+    if (!responses?.[0] || responses[0].error) return result({ status: 'search_unavailable' }, 502);
+    const detection = responses[0].webDetection;
+    const matches = new Map();
+    for (const page of detection?.pagesWithMatchingImages ?? []) {
+      const source = publicHttps(page.url);
+      if (!source) continue;
+      for (const imageMatch of [...(page.fullMatchingImages ?? []), ...(page.partialMatchingImages ?? [])]) {
+        const image = publicHttps(imageMatch.url);
+        if (image && !matches.has(image)) matches.set(image, { image, source });
+      }
+    }
+    return result({ status: 'candidates', verified: false, matches: [...matches.values()].slice(0, 10) });
+  } catch {
+    return result({ status: 'search_unavailable' }, 502);
+  }
+}
diff --git a/tests/logo-source-search.test.mjs b/tests/logo-source-search.test.mjs
new file mode 100644
index 0000000..a3ec765
--- /dev/null
+++ b/tests/logo-source-search.test.mjs
@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { searchLogoSources } from '../server/logo-source-search.mjs';
+
+const origin = 'https://preview.example';
+function request(body = Buffer.from('ffd8ff', 'hex'), from = origin) {
+  return new Request(origin + '/api/logo-source-search', {
+    method: 'POST', headers: { origin: from, 'content-type': 'image/jpeg' }, body
+  });
+}
+
+test('missing configuration, cross-origin and oversized uploads do not reach the provider', async () => {
+  const fetcher = () => assert.fail('unexpected provider call');
+  assert.equal((await searchLogoSources(request(), undefined, fetcher)).status, 503);
+  assert.equal((await searchLogoSources(request(undefined, 'https://other.example'), 'key', fetcher)).status, 403);
+  assert.equal((await searchLogoSources(request(Buffer.alloc(1024 * 1024 + 1)), 'key', fetcher)).status, 400);
+  assert.equal((await searchLogoSources(request(Buffer.from('not an image')), 'key', fetcher)).status, 400);
+});
+
+test('returns candidate source pairs without approving an image or forwarding credentials to a source', async () => {
+  const fetcher = async (url, options) => {
+    assert.equal(url, 'https://vision.googleapis.com/v1/images:annotate');
+    assert.equal(options.headers['x-goog-api-key'], 'key');
+    assert.equal(JSON.parse(options.body).requests[0].features[0].type, 'WEB_DETECTION');
+    return Response.json({ responses: [{ webDetection: { pagesWithMatchingImages: [{
+      url: 'https://brand.example/menu', fullMatchingImages: [{ url: 'https://brand.example/logo.png' }, { url: 'http://bad.example/logo.png' }],
+      partialMatchingImages: [{ url: 'https://brand.example/logo.png' }]
+    }] } }] });
+  };
+  const response = await searchLogoSources(request(), 'key', fetcher);
+  assert.deepEqual(await response.json(), {
+    status: 'candidates', verified: false,
+    matches: [{ source: 'https://brand.example/menu', image: 'https://brand.example/logo.png' }]
+  });
+});
