+const logoGroundSamples=new WeakMap();
+function syncLogoGroundSuggestions(){
+ const note=$('logoGroundSuggestions'),choices=$('backgrounds'),scorer=globalThis.RearContrast;
+ if(!note||!choices||!scorer)return;
+ const img=!state.removed&&!state.photoLayout&&!state.designBlocked&&!state.designProcessing&&!state.whiteCarrierWhiteOnly&&logoImg?prepareLogo():null;
+ let samples=[];
+ if(img){
+  if(state.recolorApplied&&state.recolor) samples=[{rgb:state.color.match(/[a-f0-9]{2}/gi).map(v=>parseInt(v,16)),count:1}];
+  else{
+   samples=logoGroundSamples.get(img);
+   if(!samples){
+    const probe=document.createElement('canvas'),scale=Math.min(1,160/Math.max(img.width,img.height));
+    probe.width=Math.max(1,Math.round(img.width*scale));probe.height=Math.max(1,Math.round(img.height*scale));
+    const context=probe.getContext('2d',{willReadFrequently:true});context.drawImage(img,0,0,probe.width,probe.height);
+    const pixels=context.getImageData(0,0,probe.width,probe.height).data,buckets=new Map();
+    for(let i=0;i<pixels.length;i+=4){
+     if(pixels[i+3]<128)continue;
+     const rgb=Array.from(pixels.subarray(i,i+3),v=>Math.min(255,Math.round(v/16)*16)),key=rgb.join(',');
+     if(!buckets.has(key))buckets.set(key,{rgb,count:0});
+     buckets.get(key).count+=pixels[i+3]/255;
+    }
+    samples=[...buckets.values()];logoGroundSamples.set(img,samples);
+   }
+  }
+ }
+ const ranked=palette.slice(0,5).map(([color,label])=>({color,label,score:scorer.score(samples,color)}))
+  .filter(({score})=>score&&score.lowFraction<=.1&&score.average>=3)
+  .sort((a,b)=>b.score.average-a.score.average).slice(0,2);
+ const current=scorer.score(samples,state.bg),warning=current&&(current.average<3||current.lowFraction>.2);
+ const message=(warning?'Seçili zeminde logo zor okunabilir. ':'')+(ranked.length?'Logo için önerilen zeminler: '+ranked.map(c=>c.label).join(', ')+'.':'');
+ if(note.textContent!==message)note.textContent=message;
+ if(note.hidden===!!message)note.hidden=!message;
+}
