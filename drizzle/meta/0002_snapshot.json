          "value": "\"leads\".\"quantity\" IS NULL OR (\"leads\".\"quantity\" >= 1 AND \"leads\".\"quantity\" <= 1000000)"
        },
        "lead_product": {
          "name": "lead_product",
          "value": "\"leads\".\"product_id\" IS NULL OR \"leads\".\"product_id\" IN ('BM12','BM15','BM545')"
        },
        "lead_fragrance": {
          "name": "lead_fragrance",
          "value": "\"leads\".\"fragrance\" IS NULL OR \"leads\".\"fragrance\" IN ('flambau','green_tea','bodrum_mandarin','lemon')"
        },
        "lead_complete": {
          "name": "lead_complete",
          "value": "\"leads\".\"kind\" != 'complete' OR (\"leads\".\"product_id\" IS NOT NULL AND \"leads\".\"quantity\" IS NOT NULL AND \"leads\".\"fragrance\" IS NOT NULL AND \"leads\".\"design_json\" IS NOT NULL)"
